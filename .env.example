# Copie para .env e preencha. O .env NAO vai para o git.
# Nunca cole os valores em chat (CLAUDE.md regra 8).

# --- Supabase: os dois unicos NEXT_PUBLIC_ ---
NEXT_PUBLIC_SUPABASE_URL=https://bdntlmsuxpicpmpzosbt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- So servidor (CLAUDE.md regra 4). NUNCA com prefixo NEXT_PUBLIC_ ---
# service_role ignora RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=bdntlmsuxpicpmpzosbt
SUPABASE_DB_PASSWORD=

# Aplicacao: pooler em transaction mode (6543).
# Copie do painel: Project Settings > Database > Connection string > Transaction pooler.
DATABASE_URL=
# Migrations e carga: conexao direta (5432).
DIRECT_URL=

# --- Bubble: so durante a migracao. Rotacionar no corte (specs/00-achados-de-seguranca.md 1.5) ---
BUBBLE_API_KEY=
BUBBLE_APP_URL=https://grupomegabox.bubbleapps.io

# --- E-mail (db/019, lib/email) ---
# Credencial do provedor vive aqui, nunca em tabela nem em option set
# (specs/00-achados-de-seguranca.md 1.1 — foi assim que a senha do Gmail vazou).
# EMAIL_MODO: "envio" liga o Resend; qualquer outro valor (padrao: registro) NAO envia, so loga.
EMAIL_MODO=registro
# Chave de API do Resend (resend.com > API Keys, permissao "Sending access" do dominio).
RESEND_API_KEY=
# Remetente num dominio VERIFICADO no Resend (SPF/DKIM), ex.: nao-responda@grupomegabox.com.br
EMAIL_REMETENTE=
# Segredo do processador da fila (app/api/fila-email), >= 32 caracteres aleatorios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Na Vercel, CRON_SECRET recebe O MESMO valor (o Cron manda Authorization: Bearer $CRON_SECRET).
FILA_EMAIL_SEGREDO=
